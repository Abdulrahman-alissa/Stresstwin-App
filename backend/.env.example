# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ── App security ─────────────────────────────────────────────────────────────
SECRET_KEY=generate-32-random-chars-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── OAuth — Google ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/calendar/google/callback

# ── OAuth — Microsoft ─────────────────────────────────────────────────────────
MICROSOFT_CLIENT_ID=your-azure-app-client-id
MICROSOFT_CLIENT_SECRET=your-azure-client-secret
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/calendar/outlook/callback

# ── Runtime ──────────────────────────────────────────────────────────────────
ENVIRONMENT=development
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:19006

# ── ML model storage ──────────────────────────────────────────────────────────
# Supabase Storage bucket that holds all model artifacts (create it once via
# Supabase Dashboard → Storage → New bucket → "ml-models", private).
ML_STORAGE_BUCKET=ml-models
# Local cache directory the backend downloads model files into at runtime.
# Safe to wipe at any time — it's just a cache, models re-download on demand.
# On Render, this can point at a mounted persistent disk to avoid re-downloading
# after every deploy/restart; otherwise a plain ephemeral directory is fine.
ML_MODEL_CACHE_DIR=ml/models/saved
# Refuse to publish a newly trained global model below this validation
# accuracy unless `--force` is passed to scripts/train_global.py.
ML_MIN_GLOBAL_VAL_ACCURACY=0.55
