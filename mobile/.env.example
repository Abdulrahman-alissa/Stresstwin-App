# Copy this file to .env (same folder) and fill in your backend's address.
# Expo automatically loads any variable prefixed EXPO_PUBLIC_ into the app —
# no extra config needed, just restart `npx expo start` / rebuild after editing.

# Your computer's LAN IP + backend port — NOT localhost/127.0.0.1.
# A phone or emulator is a separate device from your computer, so
# "localhost" on the phone means the phone itself, not your machine.
#
# Find your LAN IP:
#   macOS:   ipconfig getifaddr en0        (or en1 if on Wi-Fi via a dongle)
#   Linux:   hostname -I | awk '{print $1}'
#   Windows: ipconfig   →  look for "IPv4 Address" under your active adapter
#
# Android Emulator only (not a physical device): you can instead use the
# special alias 10.0.2.2, which the emulator maps back to your host machine:
#   EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000

EXPO_PUBLIC_API_BASE_URL=http://192.168.1.23:8000
